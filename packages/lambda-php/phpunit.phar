    {
        $nodes = (new DOMXPath($document))->query('logging/text');
        assert($nodes !== \false);
        $node = $nodes->item(0);
        if (!$node instanceof DOMElement || $node->parentNode === null) {
            return;
        }
        $node->parentNode->removeChild($node);
    }

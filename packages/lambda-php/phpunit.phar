        } catch (CliParserException $e) {
            throw new \PHPUnit\TextUI\CliArguments\Exception($e->getMessage(), $e->getCode(), $e);
        }
        $atLeastVersion = null;
        $backupGlobals = null;
        $backupStaticProperties = null;
        $beStrictAboutChangesToGlobalState = null;
        $bootstrap = null;
        $cacheDirectory = null;
        $cacheResult = null;
        $checkVersion = \false;
        $colors = null;
        $columns = null;
        $configuration = null;
        $warmCoverageCache = \false;
        $coverageFilter = null;
        $coverageClover = null;
        $coverageCobertura = null;
        $coverageCrap4J = null;
        $coverageHtml = null;
        $coveragePhp = null;

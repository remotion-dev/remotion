                    $testsCovering = array_merge($testsCovering, array_map('strtolower', explode(',', $option[1])));
                    $optionAllowedMultipleTimes = \true;
                    break;
                case '--uses':
                    if (str_contains($option[1], ',')) {
                        EventFacade::emitter()->testRunnerTriggeredWarning('Using comma-separated values with --uses is deprecated and will no longer work in PHPUnit 12. You can use --uses multiple times instead.');

 */
final class UnknownType extends Type
{
    public function isAssignable(Type $other): bool
    {
        return \true;
    }
    /**
     * @return 'unknown type'
     */
    public function name(): string
    {
        return 'unknown type';
    }
    /**
     * @return ''
     */
    public function asString(): string
    {
        return '';
    }
    public function allowsNull(): bool
    {
        return \true;
    }
    public function isUnknown(): bool
    {
        return \true;
    }
}

 */
final readonly class Cloner
{
    /**
     * @template OriginalType of object
     *
     * @param OriginalType $original
     *
     * @return OriginalType
     */
    public static function clone(object $original): object
    {
        try {
            return clone $original;
            /** @phpstan-ignore catch.neverThrown */
        } catch (Throwable) {
            return $original;
        }
    }
}

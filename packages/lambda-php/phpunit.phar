                    if (str_contains($option[1], ',')) {
                        EventFacade::emitter()->testRunnerTriggeredWarning('Using comma-separated values with --test-suffix is deprecated and will no longer work in PHPUnit 12. You can use --test-suffix multiple times instead.');
                    }
                    if ($testSuffixes === null) {

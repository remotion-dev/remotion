                case '--columns':
                    if (is_numeric($option[1])) {
                        $columns = (int) $option[1];
                    } elseif ($option[1] === 'max') {
                        $columns = 'max';
                    }
                    break;
                case 'c':
                case '--configuration':
                    $configuration = $option[1];

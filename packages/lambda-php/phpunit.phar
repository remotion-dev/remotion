namespace PHPUnitPHAR\SebastianBergmann\CodeCoverage\Test\TestStatus;

/**
 * @immutable
 */
abstract class TestStatus
{
    public static function unknown(): self
    {
        return new Unknown();
    }
    public static function success(): self
    {
        return new Success();
    }
    public static function failure(): self
    {
        return new Failure();
    }
    /**
     * @phpstan-assert-if-true Known $this
     */
    public function isKnown(): bool
    {
        return \false;
    }
    /**
     * @phpstan-assert-if-true Unknown $this
     */
    public function isUnknown(): bool
    {
        return \false;
    }
    /**
     * @phpstan-assert-if-true Success $this
     */
    public function isSuccess(): bool
    {
        return \false;
    }
    /**
     * @phpstan-assert-if-true Failure $this
     */
    public function isFailure(): bool
    {
        return \false;
    }
    abstract public function asString(): string;
}

{
	"extends": "./.wxt/tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"],
		"target": "ES2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noUnusedLocals": true,
		"noUnusedParameters": true
	},
	"include": ["src", "wxt.config.ts", ".wxt/wxt.d.ts"]
}

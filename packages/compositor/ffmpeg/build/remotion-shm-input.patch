--- /dev/null
+++ b/libavdevice/remotionshm.c
@@ -0,0 +1,1075 @@
+/*
+ * Remotion shared-memory video input device
+ *
+ * Frame pools are either named POSIX shared-memory objects or, on hosts
+ * without POSIX shared memory such as AWS Lambda, regular files inside one
+ * caller-designated private directory that are mapped with MAP_SHARED.

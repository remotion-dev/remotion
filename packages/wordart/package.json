{
	"name": "@remotion/wordart",
	"version": "4.0.537",
	"description": "Classic WordArt text styles for Remotion",
	"main": "dist/esm/index.mjs",
	"types": "dist/index.d.ts",
	"module": "dist/esm/index.mjs",
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/wordart"
	},
	"type": "module",
	"scripts": {
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"lint": "eslint src",
		"watch": "tsc -w",
		"make": "tsc && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [],
	"license": "Remotion License",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"dependencies": {
		"remotion": "workspace:*"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"devDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:",
		"@remotion/eslint-config-internal": "workspace:*",
		"eslint": "catalog:",
		"typescript": "catalog:"
	},
	"keywords": [
		"remotion",
		"wordart",
		"text",
		"typography"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://www.remotion.dev/docs/wordart"
}

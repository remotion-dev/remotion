{
	"repository": {
		"url": "https://github.com/remotion-dev/remotion/tree/main/packages/canvas"
	},
	"name": "@remotion/canvas",
	"version": "4.0.516",
	"description": "Headless primitives for Remotion authoring interfaces",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"module": "dist/esm/index.mjs",
	"type": "module",
	"scripts": {
		"test": "bun test src/test",
		"formatting": "oxfmt src --check",
		"format": "oxfmt src",
		"lint": "eslint src",
		"watch": "tsgo -w",
		"make": "tsgo && bun --env-file=../.env.bundle bundle.ts"
	},
	"author": "Jonny Burger <jonny@remotion.dev>",
	"contributors": [],
	"license": "Remotion License",
	"bugs": {
		"url": "https://github.com/remotion-dev/remotion/issues"
	},
	"dependencies": {
		"remotion": "workspace:*"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"require": "./dist/index.cjs",
			"module": "./dist/esm/index.mjs",
			"import": "./dist/esm/index.mjs"
		}
	},
	"devDependencies": {
		"@remotion/eslint-config-internal": "workspace:*",
		"@typescript/native-preview": "catalog:",
		"eslint": "catalog:"
	},
	"keywords": [
		"remotion",
		"canvas",
		"timeline"
	],
	"publishConfig": {
		"access": "public"
	},
	"homepage": "https://www.remotion.dev"
}

    "isbot": "5.1.40",
    "negotiator": "1.1.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "remotion": "workspace:*"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.986.0",
    "@react-router/dev": "8.3.0",
    "@remotion/bundler": "workspace:*",

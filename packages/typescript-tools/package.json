{
	"name": "@remotion/typescript-tools",
	"version": "4.0.536",
	"private": true,
	"description": "Isolated TypeScript 5 compiler API tools for the monorepo.",
	"license": "UNLICENSED",
	"exports": {
		"./package.json": "./package.json",
		"./typescript": {
			"types": "./typescript.d.ts",
			"default": "./typescript.js"
		},
		"./eslint-plugin": {
			"types": "./eslint-plugin.d.ts",
			"default": "./eslint-plugin.js"
		},
		"./eslint-parser": {
			"types": "./eslint-parser.d.ts",
			"default": "./eslint-parser.js"
		},
		"./prettier-organize-imports": {
			"types": "./prettier-organize-imports.d.ts",
			"default": "./prettier-organize-imports.js"
		},
		"./twoslash": {
			"types": "./twoslash.d.ts",
			"default": "./twoslash.mjs"
		},
		"./shiki-twoslash": {
			"types": "./shiki-twoslash.d.ts",
			"default": "./shiki-twoslash.mjs"
		}
	},
	"dependencies": {
		"@shikijs/twoslash": "3.22.0",
		"@typescript-eslint/eslint-plugin": "8.71.2",
		"@typescript-eslint/parser": "8.71.2",
		"eslint": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-organize-imports": "3.2.4",
		"twoslash": "0.3.6",
		"typescript": "5.9.3"
	}
}

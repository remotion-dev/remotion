@@ -83,6 +86,55 @@
     return false;
   }
 
+  // The SPS/PPS-only format omits the decoder config's color space. For an
+  // untagged stream VideoToolbox then invents BT.709 output attachments, which
+  // take precedence over Chromium's fallback in VideoToolboxFrameConverter.
+  // Supply the fallback before decoding instead of relabeling decoded pixels.
+  // Preserve all bitstream signaling, including range-only VUI descriptions.
+  // See https://crbug.com/532860177.
+  if (!frame_has_color_information_ && container_color_space_.IsSpecified()) {
+    CFStringRef primaries = nullptr;
+    CFStringRef transfer = nullptr;
+    CFStringRef matrix = nullptr;
+    if (!GetImageBufferColorValues(container_color_space_.ToGfxColorSpace(),
+                                   &primaries, &transfer, &matrix)) {
+      // Keep the existing decoder fallback for color spaces CoreVideo cannot
+      // represent rather than making an otherwise decodable stream fail.
+      return true;
+    }
+
+    base::apple::ScopedCFTypeRef<CFMutableDictionaryRef> extensions(
+        CFDictionaryCreateMutableCopy(
+            kCFAllocatorDefault, 0,
+            CMFormatDescriptionGetExtensions(active_format_.get())));
+    CFDictionarySetValue(extensions.get(),
+                         kCMFormatDescriptionExtension_ColorPrimaries,
+                         primaries);
+    CFDictionarySetValue(extensions.get(),
+                         kCMFormatDescriptionExtension_TransferFunction,
+                         transfer);
+    CFDictionarySetValue(extensions.get(),
+                         kCMFormatDescriptionExtension_YCbCrMatrix, matrix);
+    CFDictionarySetValue(
+        extensions.get(), kCMFormatDescriptionExtension_FullRangeVideo,
+        container_color_space_.range() == gfx::ColorSpace::RangeID::FULL
+            ? kCFBooleanTrue
+            : kCFBooleanFalse);
+
+    const auto dimensions =
+        CMVideoFormatDescriptionGetDimensions(active_format_.get());
+    base::apple::ScopedCFTypeRef<CMFormatDescriptionRef> format;
+    status = CMVideoFormatDescriptionCreate(
+        kCFAllocatorDefault, kCMVideoCodecType_H264, dimensions.width,
+        dimensions.height, extensions.get(), format.InitializeInto());
+    if (status != noErr) {
+      OSSTATUS_MEDIA_LOG(ERROR, status, media_log_.get())
+          << "CMVideoFormatDescriptionCreate() with configured color space";
+      return false;
+    }
+    active_format_ = std::move(format);
+  }
+
   return true;
 }
 

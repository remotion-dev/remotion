+// Sizes and maps a freshly created, still empty backing object for a Remotion
+// frame pool. Returns nullptr and describes the failure in |error|. The caller
+// keeps ownership of |fd| and unlinks the object on failure.
+void* MapRemotionFramePoolBacking(int fd, size_t size, std::string* error) {
+  if (ftruncate(fd, static_cast<off_t>(size)) != 0) {
+    *error = "ftruncate: " + base::safe_strerror(errno);
+    return nullptr;
+  }
+#if BUILDFLAG(IS_LINUX)
+  // Reserve the pages up front so a full tmpfs (for example a 64 MB container
+  // /dev/shm) or disk fails here instead of raising SIGBUS on the first write.
+  // fallocate() is not available everywhere (AWS Lambda's /tmp answers EPERM),
+  // so anything but a space error falls back to writing zeros, which reserves
+  // the blocks as well and costs a few milliseconds per pool.
+  if (fallocate(fd, 0, 0, static_cast<off_t>(size)) != 0) {
+    if (errno == ENOSPC || errno == EDQUOT || errno == EFBIG) {
+      *error = "fallocate: " + base::safe_strerror(errno);
+      return nullptr;
+    }
+    const std::vector<uint8_t> zeros(1 << 20, 0);
+    for (size_t offset = 0; offset < size;) {
+      const size_t chunk = std::min(zeros.size(), size - offset);
+      const ssize_t written = HANDLE_EINTR(
+          pwrite(fd, zeros.data(), chunk, static_cast<off_t>(offset)));
+      if (written <= 0) {
+        *error = "pwrite: " + base::safe_strerror(errno);
+        return nullptr;
+      }
+      offset += static_cast<size_t>(written);
+    }
+  }
+#endif
+  void* mapping =
+      mmap(nullptr, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (mapping == MAP_FAILED) {
+    *error = "mmap: " + base::safe_strerror(errno);
+    return nullptr;
+  }
+  return mapping;
+}
+#endif
 }  // namespace
 
+// All pool state is accessed on the PageHandler sequence. The native consumer
+// only reads published bytes and must finish before RemotionReleaseFrame().
+struct PageHandler::RemotionFramePool {
+  enum class SlotState { kFree, kCapturing, kReady };
+  enum class Backend { kPosixShm, kFile };
+  struct Slot {
+    SlotState state = SlotState::kFree;
+    std::string frame_id;
+  };
+
+  RemotionFramePool() = default;
+  RemotionFramePool(const RemotionFramePool&) = delete;
+  RemotionFramePool& operator=(const RemotionFramePool&) = delete;
+
+  ~RemotionFramePool() {
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX)
+    if (mapping) {
+      munmap(mapping, mapping_size);
+    }
+    // The consumer usually unlinks the name right after mapping it, so ENOENT
+    // is expected here. This only covers pools no consumer ever opened.
+    if (!name.empty()) {
+      if (backend == Backend::kFile) {
+        unlink(name.c_str());
+      } else {
+        shm_unlink(name.c_str());
+      }
+    }
+#endif
+  }
+
+  Backend backend = Backend::kPosixShm;
+  // A POSIX shared-memory name ("/rmshm-<random>") or, for the file backend,
+  // the absolute path of the mapped file inside the caller's private directory.
+  std::string name;
+  // Owns an mmap allocation, never PartitionAlloc memory. This pool's lifetime
+  // (including pending capture references) ends with the munmap above.
+  RAW_PTR_EXCLUSION void* mapping = nullptr;
+  size_t mapping_size = 0;
+  size_t slot_capacity = 0;
+  std::vector<Slot> slots;
+};

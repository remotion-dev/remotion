+Response PageHandler::RemotionCreateFramePool(
+    int slot_count,
+    int slot_capacity,
+    std::optional<std::string> backing_directory,
+    std::optional<std::string> preferred_backend,
+    std::string* shared_memory_name,
+    int* out_slot_count,
+    int* out_slot_capacity,
+    std::string* out_backend) {
+  if (!allow_unsafe_operations_ &&
+      !base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "remotion-shared-memory-capture")) {
+    return Response::ServerError(
+        "Raw frames require a trusted DevTools pipe or the "
+        "--remotion-shared-memory-capture opt-in flag");
+  }
+  if (remotion_frame_pool_) {
+    return Response::ServerError("A Remotion frame pool already exists");
+  }
+  // Bound both individual frames and the aggregate allocation before arithmetic.
+  constexpr size_t kMaxPoolBytes = 512u * 1024u * 1024u;
+  if (slot_count < 1 || slot_count > 16 || slot_capacity < 68 ||
+      slot_capacity > 256 * 1024 * 1024 ||
+      static_cast<size_t>(slot_count) >
+          kMaxPoolBytes / static_cast<size_t>(slot_capacity)) {
+    return Response::InvalidParams("Invalid Remotion frame pool dimensions");
+  }
+  const std::string backend_mode = preferred_backend.value_or("auto");
+  if (backend_mode != "auto" && backend_mode != "posix-shm" &&
+      backend_mode != "file") {
+    return Response::InvalidParams(
+        "preferredBackend must be \"auto\", \"posix-shm\" or \"file\"");
+  }
+  if (backing_directory.has_value() &&
+      (backing_directory->empty() || backing_directory->front() != '/' ||
+       backing_directory->size() > 3072 ||
+       backing_directory->find('\0') != std::string::npos)) {
+    return Response::InvalidParams(
+        "backingDirectory must be an absolute path");
+  }
+  if (backend_mode == "file" && !backing_directory.has_value()) {
+    return Response::InvalidParams(
+        "The file backend requires backingDirectory");
+  }
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_LINUX)
+  auto pool = std::make_shared<RemotionFramePool>();
+  pool->slot_capacity = static_cast<size_t>(slot_capacity);
+  pool->mapping_size = pool->slot_capacity * static_cast<size_t>(slot_count);
+  pool->slots.resize(slot_count);
+  // |pool->name| stays empty until a backing object is fully mapped, so the
+  // destructor never unlinks an object this pool does not own.
+  std::string errors;
+  const auto add_error = [&errors](const std::string& error) {
+    if (!errors.empty()) {
+      errors += "; ";
+    }
+    errors += error;
+  };
+
+  if (backend_mode != "file") {
+    // macOS limits POSIX shm names to 31 bytes. Decimal uint64 gives <= 27 here.
+    const std::string name =
+        "/rmshm-" + base::NumberToString(base::RandUint64());
+    const int fd = shm_open(name.c_str(), O_CREAT | O_EXCL | O_RDWR, 0600);
+    if (fd < 0) {
+      // Typically ENOENT without /dev/shm, as in AWS Lambda. Never unlink an
+      // existing object if O_EXCL failed.
+      add_error("shm_open: " + base::safe_strerror(errno));
+    } else {
+      std::string error;
+      void* mapping =
+          MapRemotionFramePoolBacking(fd, pool->mapping_size, &error);
+      close(fd);
+      if (mapping) {
+        pool->backend = RemotionFramePool::Backend::kPosixShm;
+        pool->name = name;
+        pool->mapping = mapping;
+      } else {
+        shm_unlink(name.c_str());
+        add_error("posix-shm " + error);
+      }
+    }
+  }
+
+  if (!pool->mapping && backend_mode != "posix-shm" &&
+      backing_directory.has_value()) {
+    // A file-backed MAP_SHARED mapping needs no /dev/shm. Both processes map
+    // the same page-cache pages, so visibility is identical to POSIX shm; the
+    // kernel merely also writes the pages back to the file on its own schedule.
+    struct stat directory_stat;
+    if (stat(backing_directory->c_str(), &directory_stat) != 0) {
+      add_error("backingDirectory: " + base::safe_strerror(errno));
+    } else if (!S_ISDIR(directory_stat.st_mode)) {
+      add_error("backingDirectory: not a directory");
+    } else {
+      const std::string path = *backing_directory + "/rmshm-" +
+                               base::NumberToString(base::RandUint64());
+      // O_EXCL and O_NOFOLLOW guarantee this creates a brand-new regular file
+      // rather than opening anything that already existed at the path.
+      const int fd = open(path.c_str(),
+                          O_CREAT | O_EXCL | O_RDWR | O_CLOEXEC | O_NOFOLLOW,
+                          0600);
+      if (fd < 0) {
+        add_error("open: " + base::safe_strerror(errno));
+      } else {
+        std::string error;
+        void* mapping = nullptr;
+        struct stat file_stat;
+        if (fstat(fd, &file_stat) != 0) {
+          error = "fstat: " + base::safe_strerror(errno);
+        } else if (!S_ISREG(file_stat.st_mode)) {
+          error = "not a regular file";
+        } else {
+          mapping = MapRemotionFramePoolBacking(fd, pool->mapping_size, &error);
+        }
+        close(fd);
+        if (mapping) {
+          pool->backend = RemotionFramePool::Backend::kFile;
+          pool->name = path;
+          pool->mapping = mapping;
+        } else {
+          unlink(path.c_str());
+          add_error("file " + error);
+        }
+      }
+    }
+  }
+
+  if (!pool->mapping) {
+    return Response::ServerError("Could not create Remotion shared memory (" +
+                                 errors + ")");
+  }
+  *shared_memory_name = pool->name;
+  *out_slot_count = slot_count;
+  *out_slot_capacity = slot_capacity;
+  *out_backend =
+      pool->backend == RemotionFramePool::Backend::kFile ? "file" : "posix-shm";
+  remotion_frame_pool_ = std::move(pool);
+  return Response::Success();
+#else
+  return Response::ServerError("Raw frames are only supported on macOS/Linux");
+#endif
+}
+
+Response PageHandler::RemotionReleaseFrame(int slot,
+                                          const std::string& frame_id) {
+  if (!remotion_frame_pool_ || slot < 0 ||
+      static_cast<size_t>(slot) >= remotion_frame_pool_->slots.size()) {
+    return Response::InvalidParams("Invalid Remotion frame slot");
+  }
+  auto& state = remotion_frame_pool_->slots[slot];
+  if (state.state != RemotionFramePool::SlotState::kReady ||
+      state.frame_id != frame_id) {
+    return Response::InvalidParams("Frame slot is not ready or frameId differs");
+  }
+  state = RemotionFramePool::Slot();
+  return Response::Success();
+}
+
+Response PageHandler::RemotionDestroyFramePool() {
+  if (!remotion_frame_pool_) {
+    return Response::Success();
+  }
+  for (const auto& slot : remotion_frame_pool_->slots) {
+    if (slot.state != RemotionFramePool::SlotState::kFree) {
+      return Response::ServerError("Remotion frame pool still has owned slots");
+    }
+  }
+  remotion_frame_pool_.reset();
+  return Response::Success();
+}

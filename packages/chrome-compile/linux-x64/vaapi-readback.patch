+#if BUILDFLAG(IS_LINUX)
+scoped_refptr<VideoFrame> DownloadVaSurface(VaapiWrapper& wrapper,
+                                            VASurfaceID surface,
+                                            const FrameResource& frame) {
+  const auto format = frame.format();
+  const auto& size = frame.coded_size();
+  if (format != PIXEL_FORMAT_NV12 && format != PIXEL_FORMAT_P010LE) {
+    return nullptr;
+  }
+  const VAImageFormat image_format =
+      format == PIXEL_FORMAT_NV12
+          ? VAImageFormat{.fourcc = VA_FOURCC_NV12, .byte_order = VA_LSB_FIRST,
+                          .bits_per_pixel = 12}
+          : VAImageFormat{.fourcc = VA_FOURCC_P010, .byte_order = VA_LSB_FIRST,
+                          .bits_per_pixel = 16};
+  // CreateVaImage synchronizes the original decoder surface before vaGetImage.
+  auto mapped = wrapper.CreateVaImage(surface, image_format, size);
+  if (!mapped) {
+    return nullptr;
+  }
+  const VAImage& image = *mapped->image();
+  if (image.format.fourcc != image_format.fourcc || image.num_planes != 2 ||
+      image.width != size.width() || image.height != size.height()) {
+    return nullptr;
+  }
+  // SAFETY: libva maps image.buf for image.data_size bytes until mapped dies.
+  auto source = UNSAFE_BUFFERS(base::span(
+      static_cast<const uint8_t*>(mapped->va_buffer()->data()), image.data_size));
+  auto region = base::ReadOnlySharedMemoryRegion::Create(
+      VideoFrame::AllocationSize(format, size));
+  if (!region.IsValid()) {
+    return nullptr;
+  }
+  auto destination = region.mapping.GetMemoryAsSpan<uint8_t>();
+  for (size_t plane = 0; plane < 2; ++plane) {
+    const size_t rows = VideoFrame::Rows(plane, format, size.height());
+    const size_t bytes = VideoFrame::RowBytes(plane, format, size.width());
+    const size_t pitch = base::span(image.pitches)[plane];
+    const size_t offset = base::span(image.offsets)[plane];
+    if (pitch < bytes || offset > source.size() || rows == 0 ||
+        bytes > source.size() - offset ||
+        rows - 1 > (source.size() - offset - bytes) / pitch) {
+      return nullptr;
+    }
+    for (size_t row = 0; row < rows; ++row) {
+      destination.take_first(bytes).copy_from(
+          source.subspan(offset + row * pitch, bytes));
+    }
+  }
+  auto mapping = region.region.Map();
+  if (!mapping.IsValid()) {
+    return nullptr;
+  }
+  auto result = VideoFrame::WrapExternalData(
+      format, size, frame.visible_rect(), frame.natural_size(),
+      mapping.GetMemoryAsSpan<const uint8_t>(), frame.timestamp());
+  if (result) {
+    result->BackWithOwnedSharedMemory(std::move(region.region),
+                                      std::move(mapping));
+  }
+  return result;
+}
+#endif  // BUILDFLAG(IS_LINUX)

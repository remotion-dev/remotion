import("//build/args/headless.gn")
dcheck_always_on = false
is_official_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
enable_keystone_registration_framework = false
enable_linux_installer = false
enable_media_remoting = false

enable_swiftshader_vulkan = false

ffmpeg_branding = "Chrome"
headless_use_embedded_resources = true
icu_use_data_file = false

is_debug = false
proprietary_codecs = true
target_cpu = "x64"
target_os = "linux"
use_cups = false
use_pulseaudio = false
v8_target_cpu = "x64"

chrome_pgo_phase = 0

use_sysroot = false
use_qt = false

use_on_device_model_service = false
enable_print_preview = true
use_dawn = false
skia_use_dawn = false
# Chromium 157 enables OpenXR (WebXR) on Linux; its loader includes the
# system <vulkan/vulkan.h>, which use_sysroot = false builds don't have.
# headless_shell never needs WebXR, and 149 didn't build it either.
enable_openxr = false
enable_pdf = true
enable_printing = true
use_system_minigbm = false
clang_use_chrome_plugins = false
# Since Chromium 149 a number of `chrome/...` BUILD.gn targets have
# unconditional references to (or asserts on) optional subsystems like
# extensions, platform apps, Lens, compose, glic, background mode, captive
# portal detection and notifications. If those subsystems are force-disabled via
# args.gn, `gn gen` fails while parsing the full build graph even though
# headless_shell itself doesn't depend on any of them. Leaving these flags at
# their Chromium defaults keeps the build graph consistent; unused code won't be
# linked into headless_shell.
